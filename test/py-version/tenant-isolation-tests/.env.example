# Sao chép thành .env rồi điền giá trị thật (KHÔNG commit file .env)
# Nạp vào shell:  set -a; source .env; set +a

# Bắt buộc – kết nối bằng chính role app_user (lấy từ k3s secret)
APP_USER_DSN=postgresql://app_user:CHANGE_ME@db-host:5432/appdb?sslmode=require

# Bắt buộc – chỉ dùng để dựng/xóa schema fixture, phải là superuser (hoặc có BYPASSRLS + SET ROLE app_owner)
ADMIN_DSN=postgresql://postgres:CHANGE_ME@db-host:5432/appdb?sslmode=require

# Tùy chọn
# FIXTURE_SCHEMA=tbl_fixture   # phải bắt đầu bằng "tbl_"
# OWNER_ROLE=app_owner
# KEEP_FIXTURE=1               # giữ lại schema sau khi chạy để tự soi bằng psql
